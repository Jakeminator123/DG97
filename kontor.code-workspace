{
  "folders": [{ "path": "." }],
  "settings": {
    "terminal.integrated.defaultProfile.windows": "PowerShell",

    "terminal.integrated.profiles.windows": {
      "PowerShell": {
        "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
        "args": [
          "-NoExit",
          "-Command",
          "[Console]::InputEncoding=[System.Text.UTF8Encoding]::new($false);[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false)"
        ]
      },
      "Command Prompt": { "path": "C:\\Windows\\System32\\cmd.exe" }
    },

    /* Viktigt: gör så att AGENT/automation också använder PS7 + UTF-8 */
    "terminal.integrated.automationProfile.windows": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "args": [
        "-NoLogo",
        "-Command",
        "[Console]::InputEncoding=[System.Text.UTF8Encoding]::new($false);[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false)"
      ]
    },

    "terminal.integrated.cwd": "${workspaceFolder}",
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.env.windows": {
      "PYTHONUTF8": "1",
      "PYTHONIOENCODING": "utf-8"
    },

    "python.defaultInterpreterPath": "C:\\Program Files\\Python313\\python.exe",
    "python.terminal.activateEnvironment": true,

    "editor.formatOnSave": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": true,
      "**/dist": true,
      "**/build": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/dist": true,
      "**/build": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "ms-vscode.powershell",
      "esbenp.prettier-vscode"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "py: run (default)",
        "type": "shell",
        "command": "${config:python.defaultInterpreterPath}",
        "args": ["${file}"],
        "options": { "cwd": "${workspaceFolder}" }
      },
      {
        "label": "py: pytest (default)",
        "type": "shell",
        "command": "${config:python.defaultInterpreterPath}",
        "args": ["-m", "pytest", "-q"],
        "options": { "cwd": "${workspaceFolder}" }
      },
      {
        "label": "py: create .venv (+ pip + requirements) [valfritt]",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
          "if (!(Test-Path .venv)) { py -3.13 -m venv .venv }; .\\.venv\\Scripts\\python.exe -m pip install -U pip; if (Test-Path requirements.txt) { .\\.venv\\Scripts\\pip.exe install -r requirements.txt }"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      },
      {
        "label": "py: run (prefer .venv, else system)",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command",
          "if (Test-Path .venv\\Scripts\\python.exe) { & .\\.venv\\Scripts\\python.exe \"${file}\" } else { & \"C:\\\\Program Files\\\\Python313\\\\python.exe\" \"${file}\" }"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      },
      {
        "label": "env: versions (python/node/npm)",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-NoProfile", "-Command",
          "Write-Host ('python: ' + (& ${config:python.defaultInterpreterPath} -V)); node -v; npm -v; if (Test-Path .nvmrc) { Write-Host ('nvm (.nvmrc): ' + (Get-Content .nvmrc -Raw).Trim()) }"
        ],
        "options": { "cwd": "${workspaceFolder}" }
      }
    ]
  }
}
