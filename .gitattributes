# Auto normalize line endings (use LF in repo)
* text=auto eol=lf

# Explicitly declare text files you want normalized (LF in repo, auto on checkout)
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific scripts (should use CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.glb binary
*.gltf binary
*.zip binary
*.pdf binary

